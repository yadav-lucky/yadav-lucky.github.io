# Copy this file to ".env" and adjust values for your environment.
# ".env" is gitignored and must NEVER be committed.

# ---- Server ----
# Port the app listens on
PORT=3000
# Host to bind. Use 0.0.0.0 to accept external connections (e.g. on a server/container)
HOST=0.0.0.0
# "development" or "production"
APP_ENV=development

# ---- Paths (optional overrides) ----
# Directory that holds profile.json and messages.json
DATA_DIR=./data

# ---- Security / CORS ----
# Comma-separated list of allowed origins for cross-origin requests.
# Leave empty for same-origin deployments.
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# Public contact email shown in the UI / attributed to submissions
CONTACT_EMAIL=lucky902657@gmail.com
